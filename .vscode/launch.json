{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET: LocalEnterprise.Api (http)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dotnet: build LocalEnterprise.Api",
      "program": "${workspaceFolder}/src/Backend/LocalEnterprise.Api/bin/Debug/net10.0/LocalEnterprise.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Backend/LocalEnterprise.Api",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": ".NET: LocalEnterprise.Api (https)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dotnet: build LocalEnterprise.Api",
      "program": "${workspaceFolder}/src/Backend/LocalEnterprise.Api/bin/Debug/net10.0/LocalEnterprise.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Backend/LocalEnterprise.Api",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7243;http://localhost:5218"
      }
    },
    {
      "name": ".NET: LocalEnterprise.Tests.Unit",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dotnet: build tests",
      "program": "${workspaceFolder}/src/Backend/LocalEnterprise.Tests.Unit/bin/Debug/net10.0/LocalEnterprise.Tests.Unit.dll",
      "cwd": "${workspaceFolder}/src/Backend/LocalEnterprise.Tests.Unit",
      "console": "internalConsole"
    },
    {
      "name": ".NET: LocalEnterprise.Tests.Integration",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dotnet: build tests",
      "program": "${workspaceFolder}/src/Backend/LocalEnterprise.Tests.Integration/bin/Debug/net10.0/LocalEnterprise.Tests.Integration.dll",
      "cwd": "${workspaceFolder}/src/Backend/LocalEnterprise.Tests.Integration",
      "console": "internalConsole"
    }
  ],
  "compounds": [
    {
      "name": ".NET: Backend stack",
      "configurations": [
        ".NET: LocalEnterprise.Api (http)",
        ".NET: LocalEnterprise.Tests.Unit"
      ]
    }
  ]
}
