{
    "mcpServers":  {
                       "filesystem":  {
                                          "command":  "npx",
                                          "args":  [
                                                       "-y",
                                                       "@modelcontextprotocol/server-filesystem",
                                                       "c:\\projects\\local"
                                                   ]
                                      },
                       "git":  {
                                   "command":  "npx",
                                   "args":  [
                                                "-y",
                                                "@cyanheads/git-mcp-server"
                                            ]
                               },
                       "browser":  {
                                       "command":  "npx",
                                       "args":  [
                                                    "-y",
                                                    "@playwright/mcp"
                                                ]
                                   },
                       "angular-cli":  {
                                           "command":  "npx",
                                           "args":  [
                                                        "-y",
                                                        "@angular/cli",
                                                        "mcp"
                                                    ]
                                       },
                       "dotnet":  {
                                      "command":  "npx",
                                      "args":  [
                                                   "-y",
                                                   "roslyn-codelens-mcp",
                                                   "c:\\projects\\local\\src\\Backend\\LocalEnterprise.slnx"
                                               ]
                                  },
                       "microsoft_learn":  {
                                               "command":  "npx",
                                               "args":  [
                                                            "-y",
                                                            "mcp-remote",
                                                            "https://learn.microsoft.com/api/mcp"
                                                        ]
                                           },
                       "mongodb":  {
                                       "command":  "npx",
                                       "args":  [
                                                    "-y",
                                                    "mongodb-mcp-server",
                                                    "--readOnly"
                                                ],
                                       "env":  {
                                                   "MDB_MCP_CONNECTION_STRING":  "${env:MDB_MCP_CONNECTION_STRING}"
                                               }
                                   }
                   }
}
